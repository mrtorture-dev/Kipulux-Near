# =========================================================================
# CONFIGURACIÓN DE LA BLOCKCHAIN (LOCAL HARDHAT O TESTNET ZKSYSCOIN)
# =========================================================================
RPC_URL=https://rpc-zk.tanenbaum.io/
CHAIN_ID=57057
BLOCKCHAIN_RPC=https://rpc-zk.tanenbaum.io/

# Cuenta de despliegue del Relayer corporativo
VAULT_PRIVATE_KEY=your_vault_private_key_here
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000

# Direcciones de Smart Contracts (inyectadas tras deploy)
NEO4J_OR_BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
MARKETPLACE_CONTRACT_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9

# =========================================================================
# CONFIGURACIÓN DE PROTOCOLO NEAR (TESTNET / MAINNET)
# =========================================================================
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_NAME=kipulux-8046af.testnet
NEAR_RELAYER_ACCOUNT_ID=kipu-relayer-8046af.testnet
NEAR_RELAYER_PRIVATE_KEY=ed25519:your_near_relayer_private_key_here
NEAR_MOCK_FALLBACK=true

# =========================================================================
# CONFIGURACIÓN DE PERSISTENCIA ORIENTADA A GRAFOS (NEO4J)
# =========================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =========================================================================
# SEGURIDAD, KMS Y AUTENTICACIÓN
# =========================================================================
JWT_SECRET=your_jwt_secret_key_here
PORT=3005
NODE_ENV=production
CORS_ORIGINS=https://tudominio.com,http://tudominio.com
# Soporta también fallbacks singulares:
CORS_ORIGIN=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# =========================================================================
# SERVICIOS ADICIONALES (INTEGRACIONES OPCIONALES / MOCKS DE BACKEND)
# =========================================================================
# Telegram Bot Token (para interacción con artesanos y clientes)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WooCommerce REST API
WOOCOMMERCE_CONSUMER_KEY=ck_your_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret

# Supabase Storage Client (para almacenamiento de imágenes en la nube)
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxx
SUPABASE_ANON_KEY=xxxxxx
SUPABASE_PUBLIC_BUCKET=product-media
SUPABASE_PRIVATE_BUCKET=tanning-certificates

# Pinata IPFS API (para almacenamiento inmutable)
PINATA_JWT=PEGAR_AQUI_TU_JWT_DE_PINATA
PINATA_GATEWAY=https://gateway.pinata.cloud

# SimpleFact API (para facturación y boletas SUNAT)
SIMPLEFACT_API_URL=https://api.simplefact.pe/v1
SIMPLEFACT_TOKEN_BEARER=mock
SIMPLEFACT_RUC_EMISOR=20600123456
