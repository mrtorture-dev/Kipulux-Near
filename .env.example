MARKETPLACE_CONTRACT_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9

# =========================================================================
# CONFIGURACIÓN DE PERSISTENCIA ORIENTADA A GRAFOS (NEO4J)
# =========================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =========================================================================
# SEGURIDAD, KMS Y AUTENTICACIÓN
# =========================================================================
JWT_SECRET=your_jwt_secret_key_here
PORT=3005
NODE_ENV=production
CORS_ORIGINS=https://tudominio.com,http://tudominio.com

# =========================================================================
# SERVICIOS ADICIONALES (INTEGRACIONES OPCIONALES / MOCKS DE BACKEND)
# =========================================================================
# Telegram Bot Token (para interacción con artesanos y clientes)
TELEGRAM_BOT_TOKEN=0000000000:your_telegram_bot_token_here_placeholder

# Supabase Storage Client (para almacenamiento de imágenes en la nube)
